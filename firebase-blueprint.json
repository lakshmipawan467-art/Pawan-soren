{
  "entities": {
    "Category": {
      "title": "Fund Category",
      "description": "Predefined or admin-managed village fund categories",
      "type": "object",
      "properties": {
        "nameHindi": { "type": "string", "description": "Hindi name of the fund" },
        "nameEnglish": { "type": "string", "description": "English name of the fund" },
        "description": { "type": "string", "description": "Purpose and description of fund" },
        "iconName": { "type": "string", "description": "Material icon identifier" },
        "isActive": { "type": "boolean", "description": "Whether fund is active" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Creation timestamp via serverTimestamp" },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Last updated timestamp via serverTimestamp" }
      },
      "required": ["nameHindi", "isActive"]
    },
    "Donation": {
      "title": "Donation Record",
      "description": "Donations received for village development and cultural funds",
      "type": "object",
      "properties": {
        "receiptNumber": { "type": "string", "description": "Unique digital receipt number" },
        "donorName": { "type": "string", "description": "Name of donor or Anonymous" },
        "isAnonymous": { "type": "boolean", "description": "True if donor wishes to remain anonymous" },
        "amount": { "type": "number", "description": "Donation amount in INR" },
        "categoryId": { "type": "string", "description": "Target fund category ID" },
        "categoryName": { "type": "string", "description": "Target fund category name in Hindi" },
        "paymentMethod": { "type": "string", "description": "Cash, Bank Transfer, UPI, Cheque" },
        "referenceNumber": { "type": "string", "description": "Optional transaction or receipt reference" },
        "purpose": { "type": "string", "description": "Specific donation purpose" },
        "proofNote": { "type": "string", "description": "Receipt or deposit voucher proof notes" },
        "isVerified": { "type": "boolean", "description": "Only verified donations count toward official balance" },
        "date": { "type": "string", "description": "Donation date in YYYY-MM-DD" },
        "verifiedAt": { "type": "string", "format": "date-time", "description": "Verification timestamp" },
        "verifiedBy": { "type": "string", "description": "Admin UID or email who verified" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Record creation timestamp" },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Last update timestamp" }
      },
      "required": ["receiptNumber", "amount", "categoryId", "categoryName", "isVerified", "date"]
    },
    "Expense": {
      "title": "Expense Record",
      "description": "Village fund expenditures with strict multi-stage verification",
      "type": "object",
      "properties": {
        "voucherNumber": { "type": "string", "description": "Unique expense voucher number" },
        "amount": { "type": "number", "description": "Expense amount in INR" },
        "categoryId": { "type": "string", "description": "Fund category ID" },
        "categoryName": { "type": "string", "description": "Fund category name in Hindi" },
        "purpose": { "type": "string", "description": "Detailed explanation of expenditure" },
        "vendorName": { "type": "string", "description": "Vendor, contractor, or recipient name" },
        "billNumber": { "type": "string", "description": "Invoice or bill reference number" },
        "date": { "type": "string", "description": "Expense date in YYYY-MM-DD" },
        "status": {
          "type": "string",
          "enum": [
            "Pending Approval",
            "Approved",
            "Rejected",
            "Payment Pending",
            "Paid – Awaiting Verification",
            "Verified and Recorded"
          ],
          "description": "Expense verification lifecycle status"
        },
        "rejectionReason": { "type": "string", "description": "Reason for rejection if applicable" },
        "approvedBy": { "type": "string", "description": "Admin identity who approved" },
        "verifiedBy": { "type": "string", "description": "Admin identity who verified" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Creation timestamp" },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Update timestamp" }
      },
      "required": ["voucherNumber", "amount", "categoryId", "purpose", "status", "date"]
    },
    "Project": {
      "title": "Village Project",
      "description": "Development and infrastructure projects in Bhadesar village",
      "type": "object",
      "properties": {
        "name": { "type": "string", "description": "Project title in Hindi" },
        "description": { "type": "string", "description": "Project scope and details" },
        "categoryId": { "type": "string", "description": "Associated fund category ID" },
        "estimatedBudget": { "type": "number", "description": "Estimated budget in INR" },
        "approvedBudget": { "type": "number", "description": "Approved budget in INR" },
        "spentAmount": { "type": "number", "description": "Verified spent amount in INR" },
        "startDate": { "type": "string", "description": "Start date in YYYY-MM-DD" },
        "expectedCompletionDate": { "type": "string", "description": "Target completion date in YYYY-MM-DD" },
        "status": { "type": "string", "description": "Planned, In Progress, Completed, On Hold" },
        "progressPercent": { "type": "number", "description": "Completion percentage 0-100" },
        "updates": { "type": "string", "description": "Latest progress update notes" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Creation timestamp" },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Update timestamp" }
      },
      "required": ["name", "categoryId", "approvedBudget", "status"]
    },
    "Notice": {
      "title": "Village Notice",
      "description": "Official announcements, fund summaries, and meeting notices",
      "type": "object",
      "properties": {
        "title": { "type": "string", "description": "Notice headline" },
        "content": { "type": "string", "description": "Notice full announcement text" },
        "category": { "type": "string", "description": "Meeting, Summary, Project, General" },
        "publishedDate": { "type": "string", "description": "Publish date in YYYY-MM-DD" },
        "authorName": { "type": "string", "description": "Author or Village Committee" },
        "isPinned": { "type": "boolean", "description": "Pinned at top of notice board" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Creation timestamp" },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Update timestamp" }
      },
      "required": ["title", "content", "publishedDate"]
    },
    "Complaint": {
      "title": "Villager Complaint / Question",
      "description": "Public queries or grievances regarding receipts, records, or clarifications",
      "type": "object",
      "properties": {
        "senderName": { "type": "string", "description": "Villager's name" },
        "senderContact": { "type": "string", "description": "Contact info (hidden from public, visible to admin)" },
        "type": { "type": "string", "description": "Missing Receipt, Duplicate, Entry Error, Clarification, Other" },
        "subject": { "type": "string", "description": "Summary subject" },
        "details": { "type": "string", "description": "Detailed explanation of grievance" },
        "status": { "type": "string", "description": "Pending, In Progress, Resolved" },
        "adminResponse": { "type": "string", "description": "Official committee response" },
        "respondedAt": { "type": "string", "format": "date-time", "description": "Response timestamp" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Submission timestamp" },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Update timestamp" }
      },
      "required": ["senderName", "type", "subject", "details", "status"]
    },
    "AuditLog": {
      "title": "Admin Audit Log",
      "description": "Immutable audit entries tracking all admin financial operations",
      "type": "object",
      "properties": {
        "adminEmail": { "type": "string", "description": "Admin email who performed action" },
        "action": { "type": "string", "description": "CREATE, UPDATE, VERIFY, REJECT, REVERSE" },
        "entityType": { "type": "string", "description": "DONATION, EXPENSE, PROJECT, CATEGORY" },
        "entityId": { "type": "string", "description": "Document ID affected" },
        "previousValue": { "type": "string", "description": "Previous state summary" },
        "newValue": { "type": "string", "description": "New state summary" },
        "details": { "type": "string", "description": "Reason for correction or transaction details" },
        "timestamp": { "type": "string", "format": "date-time", "description": "Action timestamp" }
      },
      "required": ["adminEmail", "action", "entityType", "entityId"]
    },
    "SystemConfig": {
      "title": "System Configuration",
      "description": "Global village registry and admin authorization metadata",
      "type": "object",
      "properties": {
        "adminEmail": { "type": "string", "description": "Designated sole admin email" },
        "villageName": { "type": "string", "description": "Name of village" },
        "villageState": { "type": "string", "description": "State / District" },
        "rulesVersion": { "type": "number", "description": "Version of village fund charter" },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Update timestamp" }
      },
      "required": ["adminEmail", "villageName"]
    }
  },
  "firestore": {
    "/categories/{categoryId}": {
      "schema": { "$ref": "#/entities/Category" },
      "description": "Village fund categories"
    },
    "/donations/{donationId}": {
      "schema": { "$ref": "#/entities/Donation" },
      "description": "All received donation records"
    },
    "/expenses/{expenseId}": {
      "schema": { "$ref": "#/entities/Expense" },
      "description": "Village expenditure records and multi-step approvals"
    },
    "/projects/{projectId}": {
      "schema": { "$ref": "#/entities/Project" },
      "description": "Village development infrastructure projects"
    },
    "/notices/{noticeId}": {
      "schema": { "$ref": "#/entities/Notice" },
      "description": "Notice board announcements and meetings"
    },
    "/complaints/{complaintId}": {
      "schema": { "$ref": "#/entities/Complaint" },
      "description": "Villager grievances and questions"
    },
    "/audit_logs/{logId}": {
      "schema": { "$ref": "#/entities/AuditLog" },
      "description": "Immutable administrative audit trail"
    },
    "/system/{configId}": {
      "schema": { "$ref": "#/entities/SystemConfig" },
      "description": "Global village configuration document"
    }
  }
}
